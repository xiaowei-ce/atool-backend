<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.atool.mapper.RoleMapper">

    <select id="getByRoleIds" resultType="org.example.atool.entity.po.securityPOs.Role">
        select * from role
        <where>
            <if test="roleIds != null">
                role_id in
                <foreach collection="roleIds" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

</mapper>