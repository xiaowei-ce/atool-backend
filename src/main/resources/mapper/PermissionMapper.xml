<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.atool.mapper.PermissionMapper">

    <select id="getByIds" resultType="org.example.atool.entity.po.securityPOs.Permission">
        SELECT * FROM permission
        <where>
            <if test="ids">
                permission_id IN
                <foreach collection="ids" open="(" separator="," close=")" item="id">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

</mapper>