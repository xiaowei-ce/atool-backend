<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.atool.mapper.RecordMapper">
    <insert id="add">
        INSERT INTO record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="record.userId != null">user_id,</if>
            <if test="record.typeId != null">type_id,</if>
            <if test="record.abstr != null and record.abstr != ''">abstr,</if>
            <if test="record.time != null">time,</if>
            <if test="record.change != null">`change`,</if>
            <if test="record.detail != null and record.detail != ''">detail,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="record.userId != null">#{record.userId},</if>
            <if test="record.typeId != null">#{record.typeId},</if>
            <if test="record.abstr != null and record.abstr != ''">#{record.abstr},</if>
            <if test="record.time != null">#{record.time},</if>
            <if test="record.change != null">#{record.change},</if>
            <if test="record.detail != null and record.detail != ''">#{record.detail},</if>
        </trim>
    </insert>

    <select id="pageGet" resultType="org.example.atool.entity.vo.RecordVO">
        select id, abstr, time, `change`, detail
        from record
        where user_id = #{userId}
        order by time desc
        limit #{now} , #{size};
    </select>
</mapper>