<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.atool.mapper.UserDetailMapper">
    <insert id="add" parameterType="org.example.atool.entity.po.UserDetail">
        insert into user_detail (
        user_id
        <trim prefixOverrides=",">
        <if test="detail.username">, username</if>
        <if test="detail.avatar">, avatar</if>
        <if test="detail.points">,points</if>
        </trim>
        )
        values (
        #{detail.userId}
        <trim prefixOverrides=",">
        <if test="detail.username">, #{detail.username}</if>
        <if test="detail.avatar">, #{detail.avatar}</if>
        <if test="detail.avatar">, #{detail.points}</if>
        </trim>
        );
    </insert>

</mapper>