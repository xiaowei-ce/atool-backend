<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.atool.mapper.RolePermissionMapper">

    <select id="getByRoles" resultType="org.example.atool.entity.po.securityPOs.RolePermission">
        SELECT * FROM role_permission
        <where>
            role_id IN
            <foreach collection="roleIds" open="(" separator="," close=")" item="id">
                #{id}
            </foreach>
        </where>
    </select>

</mapper>